
# ---- Agent tooling (local workflow only, not part of the deliverable) ----
.beads/
.dolt/
*.db
.beads-credential-key
AGENTS.md
CLAUDE.md
.claude/
.github/copilot-instructions.md

# ---- Terraform ----
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Terraform run logs - large, noisy, and regenerated on every apply
*.log
.terraformrc
terraform.rc
tfplan
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# terraform.tfvars.example is tracked; the real one is not.
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# ---- Secrets ----
# Probe service principal credentials are emitted here at apply time.
.secrets/
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# ---- Evidence output ----
# Regenerated by the validation scripts; curated findings live in docs/.
evidence/*
!evidence/.gitkeep
!evidence/README.md
!evidence/published/
!evidence/published/**

# ---- Scratch ----
scratch.md
scratch/
*.tmp

# ---- Tooling ----
.venv/
__pycache__/
*.py[cod]
node_modules/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp

